{
  "project": "feint",
  "leaks": {
    "allow": [
      "claude",
      "anthropic",
      "paranoica"
    ],
    "ignore": [
      "tests/test_leaks.py",
      "plugins/bedrock/scripts/bedrock_lib/leaks.py"
    ]
  },
  "checks": {
    "allow_hosts": [
      "registry.npmjs.org",
      "api.npmjs.org",
      "pypi.org",
      "pypistats.org"
    ],
    "ignore": [
      "tests/test_codecheck.py",
      "plugins/bedrock/skills/code-review/*",
      "plugins/bedrock/skills/design-creator/*",
      "plugins/bedrock/skills/humanize/*",
      "crates/feint-protocol/src/generated/*"
    ]
  },
  "commands": {
    "test": {
      "run": "cargo test --workspace --locked -q",
      "heavy": true
    },
    "test-related": {
      "run": "cargo test --workspace --locked -q {args}"
    },
    "lint": {
      "run": "cargo clippy --workspace --all-targets --locked -q -- -D warnings && cargo fmt --all --check"
    },
    "format": {
      "run": "cargo fmt --all"
    },
    "gen-check": {
      "run": "scripts/gen-protocol.sh --check"
    },
    "wasm-check": {
      "run": "scripts/wasm-check.sh",
      "heavy": true
    },
    "strength": {
      "run": "cargo test --release --locked -q -p airhockey --test strength -- --ignored && cargo test --release --locked -q -p penalty --test strength -- --ignored && cargo test --release --locked -q -p duel --test strength -- --ignored && cargo test --release --locked -q -p feint-compare -- --ignored",
      "heavy": true
    },
    "bar": {
      "run": "cargo test --release --locked -q -p feint-ml --test bar -- --ignored --nocapture",
      "heavy": true
    },
    "s2-eval": {
      "run": "FEINT_CHECKPOINT={args} cargo test --release --locked -q -p feint-ml --test bar -- --ignored --nocapture",
      "heavy": true
    },
    "compare": {
      "run": "cargo run --release --locked -q -p feint-compare -- web/public/compare.json 40",
      "heavy": true
    },
    "web-build": {
      "run": "scripts/web-build.sh",
      "heavy": true
    },
    "web-test": {
      "run": "scripts/web-build.sh --wasm-only && cd web && npm test --silent && npm run typecheck --silent",
      "heavy": true
    },
    "arena": {
      "run": "scripts/web-build.sh && cargo run --locked --release -p feint-arena -- --dist web/dist --data data"
    },
    "arena-check": {
      "run": "scripts/arena-check.sh",
      "heavy": true
    },
    "ffi-check": {
      "run": "scripts/ffi-check.sh",
      "heavy": true
    },
    "test-bedrock": {
      "run": "uvx pytest -p no:cacheprovider -q -o addopts=",
      "heavy": true
    },
    "lint-bedrock": {
      "run": "uvx ruff check ."
    },
    "format-bedrock": {
      "run": "uvx black -q ."
    },
    "skills": {
      "run": "python3 plugins/bedrock/scripts/skillcheck.py --root plugins/bedrock --strict"
    },
    "gym-check": {
      "run": "scripts/gym-check.sh",
      "heavy": true
    },
    "gym-throughput": {
      "run": "cd python && uv run python -m feint_train.throughput --threads 6 8",
      "heavy": true
    },
    "train-night": {
      "run": "cd python && uv run python -m feint_train.train --logdir runs/night --league --hours 6.5 --init runs/pilot-l35-g999/checkpoint.pt --gamma 0.999 --lr 1e-4 --shaping 0 --eval-opponents level:5 --eval-every 30 --eval-matches 100 --resume auto && uv run python -m feint_train.select --logdir runs/night",
      "heavy": true
    }
  },
  "critical_zones": [
    "schema/**",
    "crates/feint-protocol/src/adapter.rs",
    "crates/games/airhockey/src/**",
    "clippy.toml",
    ".gitignore",
    "crates/feint-ai/src/**"
  ],
  "kb": {
    "roots": [
      "crates"
    ]
  }
}
