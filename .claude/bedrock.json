{
  "project": "feint",
  "leaks": {
    "allow": [
      "claude",
      "anthropic",
      "paranoica"
    ],
    "ignore": [
      "tests/test_leaks.py",
      "plugins/bedrock/scripts/bedrock_lib/leaks.py"
    ]
  },
  "checks": {
    "allow_hosts": [
      "registry.npmjs.org",
      "api.npmjs.org",
      "pypi.org",
      "pypistats.org"
    ],
    "ignore": [
      "tests/test_codecheck.py",
      "plugins/bedrock/skills/code-review/*",
      "plugins/bedrock/skills/design-creator/*",
      "plugins/bedrock/skills/humanize/*"
    ]
  },
  "commands": {
    "test": {
      "run": "cargo test --workspace --locked -q",
      "heavy": true
    },
    "test-related": {
      "run": "cargo test --workspace --locked -q {args}"
    },
    "lint": {
      "run": "cargo clippy --workspace --all-targets --locked -q -- -D warnings && cargo fmt --all --check"
    },
    "format": {
      "run": "cargo fmt --all"
    },
    "test-bedrock": {
      "run": "uvx pytest -p no:cacheprovider -q -o addopts=",
      "heavy": true
    },
    "lint-bedrock": {
      "run": "uvx ruff check ."
    },
    "format-bedrock": {
      "run": "uvx black -q ."
    },
    "skills": {
      "run": "python3 plugins/bedrock/scripts/skillcheck.py --root plugins/bedrock --strict"
    }
  },
  "critical_zones": [
    "schema/**",
    "crates/feint-protocol/src/adapter.rs",
    "crates/games/airhockey/src/**",
    "clippy.toml",
    ".gitignore"
  ],
  "kb": {
    "roots": [
      "crates"
    ]
  }
}
