namespace feint.protocol;

file_identifier "FNT0";

enum TimeMode : byte { Realtime = 0, TurnBased = 1 }

enum EventKind : byte { Score = 0, RoundEnd = 1, Pause = 2, Resume = 3 }

table Dim {
  name: string;
  min: float;
  max: float;
  unit: string;
}

table ActionSpace {
  continuous: [Dim];
  discrete: uint;
}

table GameSpec {
  game_id: string;
  game_version: uint;
  num_players: ubyte = 2;
  time_mode: TimeMode;
  tick_hz: uint;
  decision_hz: uint;
  action_space: ActionSpace;
  observation: [Dim];
  body_params: [Dim];
  signals: [Dim];
  intent_labels: [string];
}

table Observation {
  tick: ulong;
  player: ubyte;
  to_act: byte = -1;
  state: [float];
  opponent_signals: [float];
  legal: [ubyte];
  score: [long];
}

table Action {
  tick: ulong;
  player: ubyte;
  values: [float];
  discrete: int = -1;
  intent: ubyte;
  deceptive: bool;
}

table Event {
  tick: ulong;
  kind: EventKind;
  player: byte = -1;
}

table BodyParams {
  values: [float];
}

table MatchHeader {
  game_id: string;
  game_version: uint;
  seed: ulong;
  level: ubyte;
  bodies: [BodyParams];
}

table MatchResult {
  score: [long];
  duration_ticks: ulong;
  level: ubyte;
  seed: ulong;
}

table Profile {
  game_id: string;
  classes: ubyte;
  bite: [double];
  bite_events: [uint];
  shots: [double];
  shot_events: uint;
  mine: [double];
  mine_events: [uint];
  fake_tries: double;
  fake_wins: double;
  theirs: [double];
  theirs_events: [uint];
  bluffs: [double];
}

union Message { GameSpec, Observation, Action, Event, MatchHeader, MatchResult, Profile }

table Envelope {
  protocol_version: string;
  message: Message;
}

root_type Envelope;
