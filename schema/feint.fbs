// Feint protocol v0.1: messages between a game and the core.
// Game-neutral by design: a game describes itself in GameSpec, so nothing here
// names a particular game (FNT-D2).

namespace feint.protocol;

file_identifier "FNT0";

enum TimeMode : byte { Realtime = 0, TurnBased = 1 }

enum EventKind : byte { Score = 0, RoundEnd = 1, Pause = 2, Resume = 3 }

table Dim {
  name: string;
  min: float;
  max: float;
  unit: string;
}

table ActionSpace {
  continuous: [Dim];
  discrete: uint;
}

table GameSpec {
  game_id: string;
  game_version: uint;
  num_players: ubyte = 2;
  time_mode: TimeMode;
  tick_hz: uint;
  decision_hz: uint;
  action_space: ActionSpace;
  observation: [Dim];
  body_params: [Dim];
  signals: [Dim];
  // Index 0 means "no intent"; the labels are for logs only.
  intent_labels: [string];
}

// What one player may see at one tick, in that player's own frame.
table Observation {
  tick: ulong;
  player: ubyte;
  // The player to act in a turn-based game; -1 when everyone acts every tick.
  to_act: byte = -1;
  state: [float];
  opponent_signals: [float];
  // 1 per legal discrete action; empty when the action space is continuous.
  legal: [ubyte];
  score: [long];
}

table Action {
  tick: ulong;
  player: ubyte;
  values: [float];
  discrete: int = -1;
  // Neither intent nor deceptive ever reaches the opponent.
  intent: ubyte;
  deceptive: bool;
}

table Event {
  tick: ulong;
  kind: EventKind;
  // -1 when the event belongs to no player.
  player: byte = -1;
}

table BodyParams {
  values: [float];
}

table MatchHeader {
  game_id: string;
  game_version: uint;
  seed: ulong;
  level: ubyte;
  bodies: [BodyParams];
}

table MatchResult {
  score: [long];
  duration_ticks: ulong;
  level: ubyte;
  seed: ulong;
}

union Message { GameSpec, Observation, Action, Event, MatchHeader, MatchResult }

table Envelope {
  protocol_version: string;
  message: Message;
}

root_type Envelope;
